THE_NEWS_API_TOKEN=replace_me
OPENAI_API_KEY=replace_me
OPENAI_AI_PICKS_MODEL=gpt-5-nano
OPENAI_COUNTRY_BRIEFING_MODEL=gpt-5-nano
OPENAI_COUNTRY_WEB_SEARCH=1
ACLED_USERNAME=replace_me
ACLED_PASSWORD=replace_me
UCDP_API_TOKEN=replace_me

# Story caches refresh in the server background by default.
BRIEFINGS_BACKGROUND_REFRESH=1
IMPORTANT_SPOTS_BACKGROUND_REFRESH=1
BRIEFINGS_REFRESH_INTERVAL_MINUTES=60
BRIEFINGS_REFRESH_BATCH_SIZE=5
# Optional comma-separated allowlists. Defaults to cached countries/spots, then a small seed set.
BRIEFINGS_REFRESH_COUNTRIES=
IMPORTANT_SPOTS_REFRESH_IDS=
